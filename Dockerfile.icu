FROM python:3.11-slim
WORKDIR /app
COPY icu_backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY icu_backend/ ./icu_backend/
COPY icu-app/ ./icu-app/
WORKDIR /app/icu_backend
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT}"]
